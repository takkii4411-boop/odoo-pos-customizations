<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_employee_add_remove_report_wizard" model="ir.ui.view">
        <field name="name">pos.employee.add.remove.report.wizard.form</field>
        <field name="model">pos.employee.add.remove.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Add Remove Report">
                <group>
                    <group string="Date Range" col="2">
                        <label for="date_from" string="Period"/>
                        <div class="o_row">
                            <field name="date_from" widget="daterange"
                                   options="{'related_end_date': 'date_to'}"/>
                            <span class="mx-2">to</span>
                            <field name="date_to" widget="daterange"
                                   options="{'related_start_date': 'date_from'}"/>
                        </div>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
