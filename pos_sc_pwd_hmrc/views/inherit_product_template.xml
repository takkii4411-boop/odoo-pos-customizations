<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Product Template View -->
        <record id="view_product_template_form_inherit_discount" model="ir.ui.view">
            <field name="name">product.template.form.discount</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//page[@name='sales']" position="inside">
                    <group string="Supported Special Discounts">
                        <field name="supported_discount_ids" widget="many2many_checkboxes"
                               domain="[('is_enabled', '=', True)]"
                               options="{'no_create': False}"
                               help="Select which special discounts can be applied to this product. These appear dynamically based on discounts created in Special Discounts menu."/>
                        <field name="supported_discount_codes" invisible="1"/>
                    </group>
                </xpath>

            </field>
        </record>

        <!-- Product Variant View -->
        <record id="view_product_product_form_inherit_discount" model="ir.ui.view">
            <field name="name">product.product.form.discount</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//sheet//group" position="inside">
                    <group string="Supported Special Discounts">
                        <field name="supported_discount_ids" widget="many2many_checkboxes"
                               domain="[('is_enabled', '=', True)]"
                               options="{'no_create': False}"
                               help="Select which special discounts can be applied to this product"/>
                        <field name="supported_discount_codes" invisible="1"/>
                    </group>
                </xpath>

            </field>
        </record>

    </data>
</odoo>