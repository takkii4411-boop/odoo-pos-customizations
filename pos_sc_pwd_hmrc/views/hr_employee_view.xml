<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_db_id" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.db.id</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='coach_id']" position="after">
                <field name="employee_db_id" string="Employee ID" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>