<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_fiscal_position_form_inherit_custom"
            model="ir.ui.view">
        <field name="name">account.fiscal.position.form.inherit.custom</field>
        <field name="model">account.fiscal.position</field>
        <field name="inherit_id" ref="account.view_account_position_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_zero_exemption_vat']" position="after">
                <field name="footer_text"/>
            </xpath>
        </field>
    </record>
</odoo>
