<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_sc_pwd_hmrc.PaymentScreen"
       t-inherit="point_of_sale.PaymentScreen"
       t-inherit-mode="extension">

        <xpath expr="//Numpad" position="replace">
            <div t-att-class="isLocked ? 'pe-none opacity-50' : ''">
                <Numpad class="'flex-grow-1'" buttons="getNumpadButtons()"/>
            </div>
        </xpath>

    </t>

    <t t-name="pos_sc_pwd_hmrc.PaymentScreenMethods"
       t-inherit="point_of_sale.PaymentScreenMethods"
       t-inherit-mode="extension">

        <xpath expr="//div[hasclass('paymentmethods-container')]" position="attributes">
            <attribute name="t-att-class">
                isLocked
                    ? 'paymentmethods-container overflow-y-auto flex-grow-1 pe-none opacity-60'
                    : 'paymentmethods-container overflow-y-auto flex-grow-1'
            </attribute>
        </xpath>

    </t>

    <t t-name="point_of_sale.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('js_invoice')]" position="replace">
        </xpath>
    </t>

    <t t-name="point_of_sale.ClosePosPopup"
       t-inherit="point_of_sale.ClosePosPopup"
       t-inherit-mode="extension">
        <xpath expr="//button[contains(@t-on-click,'downloadSalesReport')]" position="replace">
        </xpath>
    </t>

</templates>