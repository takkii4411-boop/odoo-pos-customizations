<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Senior Citizen Discount -->
        <record id="discount_senior_citizen" model="pos.special.discount">
            <field name="name">Senior Citizen Discount</field>
            <field name="discount_code">senior</field>
            <field name="button_name">SC</field>
            <field name="discount_rate">20.0</field>
            <field name="vat_treatment">vat_exempt</field>
            <field name="on_line_text">Less 20% SC Discount</field>
            <field name="sequence">10</field>
            <field name="is_enabled">True</field>
            <field name="is_default_discount">True</field>
        </record>

